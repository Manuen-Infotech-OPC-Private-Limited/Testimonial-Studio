# MongoDB Atlas or local MongoDB connection string
# Replace <username> and <db_password> with your real credentials (without angle brackets)
MONGODB_URI=mongodb+srv://<username>:<db_password>@cluster0.xxxxx.mongodb.net/testimonial-studio?appName=Cluster0
PORT=5000
# Required in production (minimum 32 random characters)
JWT_SECRET=replace-with-a-long-32-plus-character-random-secret
# Comma-separated frontend origins allowed by CORS & CSP (e.g. GitHub Pages URL)
ALLOWED_ORIGINS=https://manuen-infotech-opc-private-limited.github.io
# Frontend build-time API base URL (used when frontend is hosted separately on GitHub Pages)
VITE_API_URL=https://your-render-service.onrender.com

